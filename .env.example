# Copy this file to .env and adjust as needed.

# Port the Node server listens on. On Hostinger's Node.js Selector, this is
# usually assigned for you — use whatever value it shows in hPanel.
PORT=3000

# Allowed origin for Socket.IO connections. Use * for local development;
# set this to your real domain (e.g. https://yourschool.com) in production.
CORS_ORIGIN=*

# ---- Optional: class history (Supabase / Postgres) ----
# Without these, the app works exactly the same for live classes — nothing
# breaks. You just won't get a "My Past Classes" history, saved notes, or
# attendance records after a class ends. Get these from your Supabase
# project: Settings → API.
#
# SUPABASE_URL must be the project URL (https://xxxx.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the *service_role* secret key — NOT the
# anon/public key. Never expose this key to the browser; it's only read
# on the server. Treat it like a password.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
